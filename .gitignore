firmware/esp32/exo_armband_hybrid_6clf/exo_armband_hybrid/means.h
firmware/esp32/exo_armband_hybrid_6clf/exo_armband_hybrid/MODEL.h
firmware/esp32/exo_armband_hybrid_6clf/exo_armband_hybrid/stds.h
